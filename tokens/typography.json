    "fontFamilies": {
        "display": {
            "family": "Poppins",
            "googleFontsImport": "https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&display=swap",
            "fallback": [
                "system-ui",
                "sans-serif"
            ],
            "weightsUsed": {
                "medium": 500,
                "semibold": 600,
                "bold": 700
            },
            "usedFor": [
                "display",
                "headline",
                "title"
            ]
        },
        "body": {
            "family": "Inter",
            "googleFontsImport": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500&display=swap",
            "fallback": [
                "system-ui",
                "sans-serif"
            ],
            "weightsUsed": {
                "regular": 400,
                "medium": 500
            },
            "usedFor": [
                "body",
                "label"
            ]
        }
    },
    "breakpoints": {
        "mobile": {
            "minWidth": 0,
            "description": "Default / mobile-first"
